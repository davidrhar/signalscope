<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup="false" stops cloud backup, but on Android 12+ it does NOT stop device-to-device
  transfer: <device-transfer> defaults to including the whole app data directory. The app's data
  directory holds signalscope.db, signalscope-map.db and the device_profile preferences — cell
  identities, carrier identity, IP addresses and a binned movement history. None of that should
  ride along to a new handset without the user re-collecting it there.

  Both sections therefore exclude the entire data root. An empty allow-list is not the same
  thing: the platform requires an explicit exclusion to override the default include.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
