# Copy to keystore.properties and fill in. That file is gitignored and must never be committed.
#
# Generate the keystore once (see docs/release.md), then point storeFile at it. A relative path is
# resolved against the repository root; a path outside the repository is better still, because the
# key should survive the working copy being deleted.
#
# storeFile=../signalscope-release.jks
storeFile=
keyAlias=signalscope

# PASSWORDS: prefer the macOS keychain over this file, which is plaintext at rest.
#
#   security add-generic-password -a "$USER" -s signalscope-release -w
#
# The build reads that first and only falls back to the two fields below, which exist so a machine
# without the keychain entry -- CI, a fresh clone -- can still sign. Leave them blank when the
# keychain entry exists. Optional: keychainService= to use a name other than signalscope-release.
keychainService=
storePassword=
keyPassword=
